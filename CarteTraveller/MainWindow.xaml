<Window x:Class="CarteTraveller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CarteTraveller.Controls"
        xmlns:local="clr-namespace:CarteTraveller"
        Title="Traveller Sector Mapper" Height="800" Width="1000"
        Background="#121212">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <!-- Panneau latéral -->
            <ColumnDefinition Width="*"/>
            <!-- Carte vectorielle -->
        </Grid.ColumnDefinitions>

        <!-- Panneau de Contrôle Latéral -->
        <Border Grid.Column="0" Background="#1E1E24" BorderBrush="#333" BorderThickness="0,0,1,0" Padding="15">
            <StackPanel x:Name="ControlPanel">
                <TextBlock Text="CALCULATEUR DE SAUT" Foreground="Azure" FontWeight="Bold" FontSize="14" Margin="0,0,0,20"/>

                <TextBlock Text="Hexagone Origine (ex: 00000101)" Foreground="Gray" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtOrigin" Text="00000101" Background="#2A2A32" Foreground="White" BorderBrush="#444" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Hexagone Cible (ex: 00000504)" Foreground="Gray" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtTarget" Text="00000504" Background="#2A2A32" Foreground="White" BorderBrush="#444" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Capacité de Saut (Jump-N)" Foreground="Gray" FontSize="11" Margin="0,0,0,3"/>
                <ComboBox x:Name="CboJump" SelectedIndex="1" Background="#2A2A32"  Foreground="White" Margin="0,0,0,25">
                    <ComboBoxItem Content="Jump-1"/>
                    <ComboBoxItem Content="Jump-2"/>
                    <ComboBoxItem Content="Jump-3"/>
                    <ComboBoxItem Content="Jump-4"/>
                    <ComboBoxItem Content="Jump-5"/>
                    <ComboBoxItem Content="Jump-6"/>
                </ComboBox>

                <Button Content="CALCULER LA ROUTE" Click="OnCalculateRouteClick" 
                        Background="#2B5B84" Foreground="White" FontWeight="Bold" Padding="10" Cursor="Hand"/>

                <!-- Zone de message d'erreur / statut -->
                <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Margin="0,20,0,0" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- On encapsule la carte pour pouvoir scroller vu qu'elle dépassera de l'écran -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <!-- Notre contrôle personnalisé. 
                 On lie (Bind) la propriété SectorData au modèle de vue (ViewModel) -->
            <controls:SectorMapControl 
                x:Name="MapControl" 
                Width="1500" Height="1800" 
                Margin="20"/>

        </ScrollViewer>
    </Grid>
</Window>
